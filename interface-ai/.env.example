# Copy to .env and adjust. All values are validated at startup (src/assessments/config.py);
# an invalid config exits with code 2 and a log line naming the bad setting.
# Never commit .env. Keep comments on their own lines: dotenv treats `KEY= # x` as a value.

# --- Service -----------------------------------------------------------------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Docker Compose overrides HOST to 0.0.0.0
HOST=127.0.0.1
PORT=8000

# --- Storage -----------------------------------------------------------------
# Capability artifacts and run evidence (screenshots, traces, logs). Gitignored.
DATA_DIR=data

# --- Model provider ----------------------------------------------------------
# Required only for discovery (`assessments discover`); replay never calls a model.
# Set LLM_PROVIDER=anthropic to validate at startup that the key is present.
LLM_PROVIDER=
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- Agent / browser safety --------------------------------------------------
# Comma-separated hosts the agent's browser may visit; wildcards are rejected.
ALLOWED_HOSTS=localhost,127.0.0.1
BROWSER_HEADLESS=true
AGENT_MAX_STEPS=30

# --- Target application (tenant) ---------------------------------------------
# Base URL of the app instance automation runs against (the local demo bank by default).
TARGET_BASE_URL=http://localhost:8001
# Where app profiles, task specs and capability artifacts live (committed, reviewable).
CATALOG_DIR=catalog
# Seconds a run waits for a human to resolve an intervention before aborting.
HANDOFF_TIMEOUT_S=600

# Tenant credentials referenced by capabilities (by env var name, never by value).
# These are the synthetic credentials of the local demo bank.
HARBOR_OPERATOR_ID=teller1
HARBOR_OPERATOR_PASSWORD=harbor-demo

# Used only by `--simulate-operator` (a scripted stand-in for a human supervisor in demos).
DEMO_SUPERVISOR_ID=sup01
DEMO_SUPERVISOR_PIN=4321

# --- Policy allowlists (beyond hosts) ------------------------------------------
# Comma-separated regexes over URL paths automation may act on (default: any path on an allowed host).
ALLOWED_PATHS=/,/signon,/console,/banner,/nav,/main/.*
# Comma-separated action types automation may take: click,fill,select,press,extract,navigate
ALLOWED_ACTIONS=click,fill,select,press,extract,navigate
